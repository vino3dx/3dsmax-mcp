[
  {
    "tool": "convert_to_editable_poly",
    "title": "box converts to an 8-vertex / 6-face poly",
    "payload": {
      "objects": [
        "Box001"
      ]
    },
    "steps": [
      {
        "method": "create_box",
        "payload": {
          "class": "Box"
        }
      }
    ],
    "readback": [
      {
        "method": "poly_get_stats",
        "expect": {
          "objects.0.verts": 8,
          "objects.0.faces": 6
        },
        "payload": {
          "objects": [
            "Box001"
          ]
        }
      }
    ]
  },
  {
    "tool": "poly_get_verts",
    "title": "vertex dump lists all 8 vertices",
