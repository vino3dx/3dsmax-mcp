[
  {
    "tool": "create_box",
    "title": "box appears in the scene with 6 faces",
    "payload": {},
    "readback": [
      {"method": "scene_info", "expect": {"objectCount": 1}},
      {"method": "list_objects", "expect": {"count": 1, "objects.0.class": "Box",
                                           "objects.0.faceCount": 6}}
    ]
  },
  {
    "tool": "create_sphere",
    "title": "sphere is a Sphere",
    "payload": {},
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.class": "Sphere"}}
    ]
  },
  {
    "tool": "create_cylinder",
    "title": "cylinder is a Cylinder",
    "payload": {},
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.class": "Cylinder"}}
    ]
  },
  {
    "tool": "create_teapot",
    "title": "teapot is a Teapot",
    "payload": {},
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.class": "Teapot"}}
    ]
  },
  {
    "tool": "create_line",
    "title": "line from three points is a Line shape",
    "payload": {"points": [[0, 0, 0], [20, 0, 0], [20, 20, 0]]},
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.class": "Line"}}
    ]
  },
  {
    "tool": "create_rectangle",
    "title": "rectangle is a Rectangle shape",
    "payload": {},
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.class": "Rectangle"}}
    ]
  },
  {
    "tool": "transform_object",
    "title": "relative move lands at 10,5,0",
    "payload": {"operation": "move", "mode": "relative", "value": [10, 5, 0]},
    "steps": [
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.position": [10, 5, 0]}}
    ]
  },
  {
    "tool": "clone_objects",
    "title": "clone doubles the object count",
    "payload": {"count": 1},
    "steps": [
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "scene_info", "expect": {"objectCount": 2}}
    ]
  },
  {
    "tool": "rename_object",
    "title": "rename is visible in the scene",
    "payload": {"name": "Box001", "newName": "MyBox"},
    "steps": [
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "list_objects", "expect": {"objects.0.name": "MyBox"}}
    ]
  },
  {
    "tool": "get_object_info",
    "title": "object info reports name and class",
    "payload": {"name": "Box001"},
    "steps": [
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "get_object_info", "payload": {"name": "Box001"},
       "expect": {"name": "Box001", "class": "Box"}}
    ]
  },
  {
    "tool": "select_objects",
    "title": "selection holds exactly the picked object",
    "payload": {"objects": ["Box001"]},
    "steps": [
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "get_selection", "expect": {"count": 1}}
    ]
  },
  {
    "tool": "deselect_all",
    "title": "deselect empties the selection",
    "payload": {},
    "steps": [
      {"method": "create_box", "payload": {}},
      {"method": "select_objects", "payload": {"objects": ["Box001"]}}
    ],
    "readback": [
      {"method": "get_selection", "expect": {"count": 0}}
    ]
  },
  {
    "tool": "parent_objects",
    "title": "parenting shows up in the node parent field",
    "payload": {"objects": ["Box002"], "parent": "Box001"},
    "steps": [
      {"method": "create_box", "payload": {}},
      {"method": "create_box", "payload": {}}
    ],
    "readback": [
      {"method": "get_object_info", "payload": {"name": "Box002"},
       "expect": {"parent": "Box001"}}
    ]
  },
  {
    "tool": "get_hierarchy",
    "title": "hierarchy root is the scene",
    "payload": {},
    "readback": [
      {"method": "get_hierarchy", "expect": {"name": "scene"}}
    ]
  }
]
